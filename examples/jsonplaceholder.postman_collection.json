{
  "info": {
    "_postman_id": "8a1c2b40-0000-4000-8000-000000000002",
    "name": "JSONPlaceholder",
    "description": "The public fake API used as the sample workspace. No auth, real HTTP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "variable": [{ "key": "baseUrl", "value": "https://jsonplaceholder.typicode.com" }],
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "List posts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/posts?_limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [{ "key": "_limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Get post",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "1"]
            }
          }
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"hello from rq\",\n  \"body\": \"testing\",\n  \"userId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/posts", "host": ["{{baseUrl}}"], "path": ["posts"] }
          }
        },
        {
          "name": "Comments for post",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/posts/1/comments",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "1", "comments"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          }
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["users", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Todos for a user",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/todos?userId=1",
          "host": ["{{baseUrl}}"],
          "path": ["todos"],
          "query": [{ "key": "userId", "value": "1" }]
        }
      }
    }
  ]
}
